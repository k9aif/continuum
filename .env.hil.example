# K9X HIL routing (backend/hil_bridge.py): add these lines to .env to send SBB reviews and
# ABB harvesting nominations to K9X HIL and apply the decisions that come back.
CONTINUUM_HIL_ENABLED=true
# The same Kafka the public K9X HIL reads (host:port of the broker; no IPs committed here)
KAFKA_BOOTSTRAP_SERVERS=<kafka-host>:9092
CONTINUUM_PUBLIC_URL=https://continuum.k9x.ai
# Optional (defaults shown): the HIL queue registered as Architecture Review > SBB Promotion
# CONTINUUM_HIL_TASK_TOPIC=workflow.hil.k9platform.architecture.sbb-promotion
# CONTINUUM_HIL_REPLY_TOPIC=continuum.hil.replies
# CONTINUUM_HIL_GROUP=continuum-hil-replies
